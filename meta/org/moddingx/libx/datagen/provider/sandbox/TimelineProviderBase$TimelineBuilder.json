rkers#DAY</ref> can not be redefined for the <ref cls=\"net/minecraft/world/clock/WorldClocks\" field=\"OVERWORLD\">overworld clock</ref>."}},{"name":"timeMarker","modifiers":["public"],"typeId":"(net.minecraft.resources.ResourceKey<net.minecraft.world.clock.ClockTimeMarker>,int,boolean)org.moddingx.libx.datagen.provider.sandbox.TimelineProviderBase.TimelineBuilder","parameters":[{"name":"marker","type":{"name":"net.minecraft.resources.ResourceKey<net.minecraft.world.clock.ClockTimeMarker>","desc":"Lnet/minecraft/resources/ResourceKey;","binaryName":"net/minecraft/resources/ResourceKey"}},{"name":"ticks","type":{"name":"int","desc":"I"}},{"name":"showInCommands","type":{"name":"boolean","desc":"Z"},"doc":"whether the marker can be used as an argument to the <code>/time set</code> command."}],"return":{"name":"org.moddingx.libx.datagen.provider.sandbox.TimelineProviderBase.TimelineBuilder","desc":"Lorg/moddingx/libx/datagen/provider/sandbox/TimelineProviderBase$TimelineBuilder;","binaryName":"org/moddingx/libx/datagen/provider/sandbox/TimelineProviderBase$TimelineBuilder"},"doc":{"summary":"Adds a <ref cls=\"net/minecraft/world/clock/ClockTimeMarker\">time marker</ref> at the given tick to the clock of this timeline.","text":"Adds a <ref cls=\"net/minecraft/world/clock/ClockTimeMarker\">time marker</ref> at the given tick to the clock of this timeline. <br>A time marker key may only be defined once per clock, so a marker like <ref cls=\"net/minecraft/world/clock/ClockTimeMarkers\" field=\"DAY\">ClockTimeMarkers#DAY</ref> can not be redefined for the <ref cls=\"net/minecraft/world/clock/WorldClocks\" field=\"OVERWORLD\">overworld clock</ref>."}},{"name":"build","modifiers":["public"],"typeId":"()net.minecraft.core.Holder<net.minecraft.world.timeline.Timeline>","parameters":[],"return":{"name":"net.minecraft.core.Holder<net.minecraft.world.timeline.Timeline>","desc":"Lnet/minecraft/core/Holder;","binaryName":"net/minecraft/core/Holder"},"doc":{"summary":"Builds the <re